# Reverse proxy with automatic HTTPS (Let's Encrypt).
# DOMAIN and ACME_EMAIL are injected from the environment (see docker-compose.prod.yml).
{
	email {$ACME_EMAIL}
}

# Admin web console
app.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# HTTP API
api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3333
}

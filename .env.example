# Copy to `.env` and fill in real values. NEVER commit the real .env.
# Used by docker-compose (dev + prod). Secrets on the VPS live only in its .env.

# ── PostgreSQL ──
POSTGRES_USER=sbs
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sbs

# ── RabbitMQ ──
RABBITMQ_DEFAULT_USER=sbs
RABBITMQ_DEFAULT_PASS=change-me-strong-password

# ── API ──
LOG_LEVEL=info
# JWT_SECRET (>= 32 chars) — added in the auth phase
JWT_SECRET=change-me-please-use-a-long-random-secret

# ── Admin seed ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# ── Production deploy (docker-compose.prod.yml) ──
# Bare domain; the app is served at app.<DOMAIN> and the API at api.<DOMAIN>.
DOMAIN=example.com
ACME_EMAIL=you@example.com
# Container image registry and tag (set by CI on deploy).
REGISTRY=ghcr.io/jumaelmartins
IMAGE_TAG=latest
